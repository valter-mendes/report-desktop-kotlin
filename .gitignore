# Build outputs
build/
bin/
out/
*.class

# Gradle
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# Kotlin
.kotlin/

# IDE
.idea/
*.iml
.vscode/
.vs/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Secrets / certs — don't commit these
certs/
*.jks
*.p12
*.pem
*.key

# ...except the public DigiCert intermediate the app bundles to talk to SIRA.
# reporteshml.cmc.ao / reportes.cmc.ao don't send it during the TLS handshake,
# so buildSiraTrustManager() needs it on the classpath. It's a public CA cert
# (published at cacerts.digicert.com), not a secret — every build must have it.
!src/main/resources/certs/
!src/main/resources/certs/*.pem

# Local machine-specific config
local.properties

# Compiled distributables (the .deb you have in build/compose/binaries)
*.deb
*.dmg
*.msi
*.exe